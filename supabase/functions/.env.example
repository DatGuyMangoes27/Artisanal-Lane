SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TRADESAFE_CLIENT_ID=your-tradesafe-client-id
TRADESAFE_CLIENT_SECRET=your-tradesafe-client-secret
TRADESAFE_CALLBACK_SECRET=choose-a-random-callback-secret
TRADESAFE_AUTH_URL=https://auth.tradesafe.co.za/oauth/token
TRADESAFE_GRAPHQL_URL=https://api.tradesafe.co.za/graphql
# TradeSafe token belonging to Artisan Lane. Bob Go courier fees are paid to
# this party as a fixed AGENT fee; they are not paid to the artisan seller.
TRADESAFE_ARTISAN_LANE_TOKEN_ID=your-artisan-lane-tradesafe-token
# Bob Go API key and base URL. The names say SANDBOX for history; for live use
# put the live key and https://api.bobgo.co.za/v2 in these same variables.
BOBGO_SANDBOX_API_KEY=your-bobgo-sandbox-api-key
BOBGO_SANDBOX_BASE_URL=https://api.sandbox.bobgo.co.za/v2
# Switch for NEW Bob Go checkouts. Anything other than "true" hides Bob Go in
# the app (bobgo-quote) and rejects bobgo_door_to_door in create-checkout.
# Orders already paid with Bob Go keep being booked/tracked/cancelled while
# BOBGO_SANDBOX_API_KEY is set. Keep false in production until sign-off.
BOBGO_SHIPPING_ENABLED=false
# Webhook signing secret from the Bob Go dashboard (Settings -> Webhook
# subscriptions). Verifies the Bobgo-Webhook-Signature header (HMAC-SHA256).
BOBGO_WEBHOOK_SECRET=choose-a-random-webhook-secret
# Set to "true" once signed webhooks are confirmed in the sandbox, to stop
# accepting the secret in the ?secret= query string / x-bobgo-webhook-secret.
BOBGO_WEBHOOK_REQUIRE_SIGNATURE=false
# Optional: header secret for the scheduled bobgo-sync-tracking call
# (x-bobgo-sync-secret). If unset, the service-role bearer token is required.
BOBGO_SYNC_SECRET=choose-a-random-sync-secret
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
# Optional: only set this if your PayFast account has a passphrase configured
# PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true
COURIER_GUY_API_KEY=your-tcg-locker-api-key
# Defaults to the TCG Locker sandbox docs host; override with the live base URL when ready.
COURIER_GUY_API_BASE_URL=https://sandbox.api-pudo.co.za

# Internal artisan AI pilot. Secrets belong on server, never in Flutter.
ARTISAN_AI_ENABLED=false
ARTISAN_AI_ALLOWED_USERS=
ARTISAN_AI_TEXT_MODEL=
ARTISAN_AI_IMAGE_MODEL=
# Configure OPENAI_API_KEY in server secret management; do not paste it here.
